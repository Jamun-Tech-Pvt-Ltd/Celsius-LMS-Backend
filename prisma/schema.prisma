generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model jmkcrsmain {
  crsmain_id        Int      @id @default(autoincrement())
  crsmain_img_url   String?  @db.VarChar(255)
  crsmain_img_key   String?  @db.VarChar(1000)
  cramain_seo_desc  String   @db.VarChar(100)
  cramain_seo_title String   @db.VarChar(50)
  created_at        DateTime @default(now())
  category          String   @db.VarChar(50)
  description       String   @db.LongText
  duration          Float
  label             String
  language          String
  lavel             String
  rate              Int
  rateUs            Float?   @default(0)
  short_description String
  start_date        DateTime
  title             String   @db.VarChar(100)
  isDeleted         Boolean  @default(false)
  requirements      String   @db.LongText
}

model jmkcrsinfo {
  crs_id             Int                  @id @default(autoincrement())
  crs_category_id    Int
  crs_name           String               @db.VarChar(200)
  crs_desc           String               @db.VarChar(1000)
  crs_duration       Float
  crs_rate           Int
  crs_rate_us        Int
  crs_ins            String               @db.VarChar(200)
  crs_start_date     DateTime?            @default(now())
  crs_image          String?              @db.VarChar(1000)
  crs_image_key      String?              @db.VarChar(1000)
  lavel              String?              @db.VarChar(200)
  time               String               @db.VarChar(200)
  isDeleted          Boolean              @default(false)
  meetLink           String?              @db.VarChar(1000)
  created_at         DateTime             @default(now())
  crs_company_id     Int                  @default(1)
  category           jmk_crs_categories   @relation(fields: [crs_category_id], references: [serial])
  company            jmkcompany           @relation(fields: [crs_company_id], references: [serial])
  crs_week           jmk_tr_week[]
  jmk_std_attendance jmk_std_attendance[]
  jmkcrstest         jmkcrstest[]
  jmkstdinfo         jmkstdinfo[]
  jmktrcrsinfo       jmktrcrsinfo[]
  jmkstdcrsinfo      jmkstdcrsinfo[]
  jmk_std_note       jmk_std_note[]
  jmktrinfo          jmktrinfo[]
}

model jmk_tr_week {
  week_id          Int                @id @default(autoincrement())
  crs_id           Int
  title            String             @db.VarChar(100)
  description      String             @db.VarChar(1000)
  created_at       DateTime           @default(now())
  jmk_week_content jmk_week_content[]
  jmkcrsinfo       jmkcrsinfo?        @relation(fields: [crs_id], references: [crs_id])
  jmkcrsinfoCrs_id Int?
}

model jmk_week_content {
  content_id    Int              @id @default(autoincrement())
  title         String           @db.VarChar(100)
  description   String           @db.VarChar(1000)
  type          jmk_content_type
  week_id       Int
  video_url     String?          @db.VarChar(1000)
  project_url   String?          @db.VarChar(1000)
  date          DateTime         @default(now())
  video_url_key String?          @db.VarChar(1000)
  duration      String?          @db.VarChar(100)
  share_date    String?          @db.VarChar(100)
  level         String?          @db.VarChar(100)
  jmk_tr_week   jmk_tr_week      @relation(fields: [week_id], references: [week_id])

  @@index([week_id], map: "jmk_week_content_week_id_fkey")
}

model jmk_test_set {
  test_set_id Int     @id @default(autoincrement())
  content_id  Int
  question    String? @db.VarChar(100)
  ans1        String? @db.VarChar(100)
  ans2        String? @db.VarChar(100)
  ans3        String? @db.VarChar(100)
  ans4        String? @db.VarChar(100)
  rtans       String? @db.VarChar(100)
  hint        String? @db.VarChar(100)
}

model jmk_std_test_result {
  serial             Int      @id @default(autoincrement())
  content_id         Int
  std_id             Int
  test_complete      Boolean  @default(false)
  score              String   @default("0")
  created_at         DateTime @default(now())
  question_attempted Int      @default(0)
  time_taken         String   @default("")
}

model jmk_std_test_ans {
  serial      Int    @id @default(autoincrement())
  content_id  Int
  std_id      Int
  std_ans     String
  test_set_id Int
}

model jmk_std_note {
  serial     Int      @id @default(autoincrement())
  crs_id     Int
  std_id     Int
  title      String
  note       String   @db.LongText
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  student jmkstdinfo @relation(fields: [std_id], references: [std_id])
  course  jmkcrsinfo @relation(fields: [crs_id], references: [crs_id])
}

model jmkstdinfo {
  std_id                Int                     @id @default(autoincrement())
  std_fname             String                  @db.VarChar(20)
  std_mname             String?                 @db.VarChar(20)
  std_lname             String                  @db.VarChar(20)
  std_email             String                  @db.VarChar(30)
  std_mobile            String                  @db.VarChar(15)
  std_birth_dt          DateTime?               @db.Date
  std_password          String                  @db.VarChar(16)
  std_pic               String?                 @db.VarChar(200)
  std_pic_key           String?                 @db.VarChar(100)
  std_verifyed          Boolean                 @default(false)
  lastSeen              DateTime                @default(now())
  created_at            DateTime                @default(now())
  updated_at            DateTime                @default(now())
  company_id            Int
  crs_id                Int
  company               jmkcompany              @relation(fields: [company_id], references: [serial])
  course                jmkcrsinfo              @relation(fields: [crs_id], references: [crs_id], onDelete: Cascade, onUpdate: NoAction, map: "jmkcrsinfo_crs_id_fk")
  jmk_crs_blog_comments jmk_crs_blog_comments[]
  jmk_std_attendance    jmk_std_attendance[]
  courses               jmkstdcrsinfo[]
  jmk_std_note          jmk_std_note[]

  @@index([crs_id], map: "jmkcrsinfo_crs_id_fk")
}

model jmkcontact {
  serial   Int       @id @default(autoincrement())
  cmobile  String?   @db.VarChar(15)
  cemail   String?   @db.VarChar(30)
  csubject String?   @db.VarChar(50)
  cmessage String?   @db.VarChar(200)
  cfname   String?   @db.VarChar(200)
  clname   String?   @db.VarChar(200)
  cdate    DateTime? @default(dbgenerated("(curdate())")) @db.Date
  cid      Int?
}

model jmktrinfo {
  tr_id       Int            @id @default(autoincrement())
  tr_fname    String         @db.VarChar(30)
  tr_mname    String?        @db.VarChar(30)
  tr_lname    String         @db.VarChar(30)
  tr_mobile   String?        @db.VarChar(15)
  tr_email    String         @db.VarChar(30)
  tr_dob      DateTime?      @db.Date
  tr_verifyed Boolean        @default(false)
  tr_password String         @db.VarChar(16)
  tr_linkedin String?        @db.VarChar(200)
  crs_id      Int?
  tr_pic      String?        @db.VarChar(500)
  tr_pic_key  String?        @db.VarChar(500)
  lastSeen    DateTime       @default(now())
  createdAt   DateTime       @default(now())
  company_id  Int
  company     jmkcompany     @relation(fields: [company_id], references: [serial])
  course      jmkcrsinfo?    @relation(fields: [crs_id], references: [crs_id])
  blogs       jmk_crs_blog[]
  courses     jmktrcrsinfo[]
}

model jmkpartnerReq {
  pr_id           Int      @id @default(autoincrement())
  pr_fname        String   @db.VarChar(30)
  pr_lname        String   @db.VarChar(30)
  pr_mobile       String?  @db.VarChar(15)
  pr_email        String?  @db.VarChar(30)
  pr_company      String   @db.VarChar(200)
  pr_company_site String?  @db.VarChar(200)
  pr_role         String   @db.VarChar(200)
  pr_remark       String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
}

model jmkjobReq {
  serial     Int            @id @default(autoincrement())
  fname      String         @db.VarChar(30)
  lname      String         @db.VarChar(30)
  mobile     String         @db.VarChar(15)
  email      String         @db.VarChar(50)
  linkedin   String         @db.VarChar(200)
  role       String         @db.VarChar(50)
  remark     String?        @db.VarChar(1000)
  resume_key String         @db.VarChar(200)
  resume     String         @db.VarChar(200)
  career_id  Int
  createdAt  DateTime       @default(now())
  career     jmk_web_career @relation(fields: [career_id], references: [serial])

  @@index([career_id], map: "jmkjobReq_career_id_fkey")
}

model jmkstdcrsinfo {
  serial            Int             @id @default(autoincrement())
  crs_id            Int
  std_id            Int
  std_crs_verirfy   Boolean         @default(false)
  discount          Int?
  amt_paid          Int?
  amt_due           Int?
  crs_complete      Boolean?        @default(false)
  crs_complete_date DateTime?       @db.Date
  createdAt         DateTime        @default(now())
  payment_option    String?
  payment_type      String?
  time              String?
  ref_id            String?
  promo_code        String?
  student           jmkstdinfo      @relation(fields: [std_id], references: [std_id])
  promo             jmk_promo_code? @relation(fields: [promo_code], references: [code], onDelete: Cascade)
  course            jmkcrsinfo      @relation(fields: [crs_id], references: [crs_id])

  @@index([promo_code], map: "jmkstdcrsinfo_promo_code_fkey")
}

model jmkcontactb {
  serial    Int       @id @default(autoincrement())
  bfname    String    @db.VarChar(20)
  blname    String    @db.VarChar(20)
  bemail    String    @db.VarChar(30)
  bcompname String    @db.VarChar(100)
  bjobrole  String    @db.VarChar(30)
  bmobile   String    @db.VarChar(20)
  bgovnpr   String?   @db.VarChar(10)
  bcompsize String?   @db.VarChar(20)
  blrnum    String?   @db.VarChar(20)
  bcountry  String?   @db.VarChar(50)
  bneeds    String?   @db.VarChar(200)
  bdate     DateTime? @default(dbgenerated("(curdate())")) @db.Date
}

model jmkcrstest {
  serial          Int        @id @default(autoincrement())
  crs_id          Int
  crs_test_con_id String     @db.VarChar(100)
  crs_test_con    String     @db.VarChar(1000)
  jmkcrsinfo      jmkcrsinfo @relation(fields: [crs_id], references: [crs_id], onDelete: NoAction, onUpdate: NoAction, map: "jmkcrsinfo_jmkcrstest_crs_id_fk")

  @@index([crs_id], map: "jmkcrsinfo_jmkcrstest_crs_id_fk")
}

model jmkcrscontents {
  serial        Int       @id @default(autoincrement())
  crs_id        Int?
  content       String?   @db.VarChar(2000)
  content_date  DateTime? @db.Date
  content_title String?   @db.VarChar(2000)
  vid_id        Int?
}

model jmktrcrsinfo {
  serial  Int        @id @default(autoincrement())
  tr_id   Int
  crs_id  Int
  course  jmkcrsinfo @relation(fields: [crs_id], references: [crs_id], onDelete: NoAction, onUpdate: NoAction)
  trainer jmktrinfo  @relation(fields: [tr_id], references: [tr_id], onDelete: NoAction, onUpdate: NoAction)
  created_at   DateTime   @default(now())

  @@index([crs_id], map: "jmktrcrsinfo_crs_id_fkey")
  @@index([tr_id], map: "jmktrcrsinfo_tr_id_fkey")
}

model jmktrloginfo {
  serial     Int       @id @default(autoincrement())
  tr_id      Int?
  login_date DateTime? @db.DateTime(0)
}

model jmkcrsovw {
  crs_con_id      Int     @id @default(autoincrement())
  crs_ovw_content String? @db.VarChar(2000)
}

model jmkuserinfo {
  usr_id       Int         @id @default(autoincrement())
  usr_code     String?     @db.VarChar(10)
  usr_email    String?     @db.VarChar(30)
  usr_password String?     @db.VarChar(20)
  usr_role     String?     @default("admin") @db.VarChar(20)
  usr_fname    String?     @db.VarChar(20)
  usr_mname    String?     @db.VarChar(20)
  usr_lname    String?     @db.VarChar(20)
  usr_img_url  String?     @db.VarChar(100)
  usr_img_key  String?     @db.VarChar(100)
  created_at   DateTime?   @default(now())
  usr_access   String?     @db.LongText
  company_id   Int?
  company      jmkcompany? @relation(fields: [company_id], references: [serial])

  @@index([company_id], map: "jmkuserinfo_company_id_fkey")
}

model jmkcompany {
  serial             Int                  @id @default(autoincrement())
  c_name             String               @db.VarChar(100)
  c_email            String               @db.VarChar(50)
  c_username         String               @unique @db.VarChar(20)
  c_country          String               @db.VarChar(50)
  c_package          String               @db.VarChar(20)
  c_package_type     String               @db.VarChar(20)
  c_bussiness_type   String               @db.VarChar(100)
  c_verified         Boolean              @default(false)
  c_phone            Int?
  c_address          String?
  c_taxid            String?
  created_at         DateTime?            @default(now())
  jmkuserinfo        jmkuserinfo[]
  jmkcrsinfo         jmkcrsinfo[]
  jmk_crs_categories jmk_crs_categories[]
  jmktrinfo          jmktrinfo[]
  jmkstdinfo         jmkstdinfo[]
  jmkfaq             jmkfaq[]
}

model jmkcrsupcom {
  serial     Int       @id @default(autoincrement())
  crsmain_id Int
  start_date DateTime? @db.Date

  @@index([crsmain_id], map: "jmkcrsupcom_crsmain_id_fkey")
}

model jmkfaq {
  faq_id     Int          @id @default(autoincrement())
  question   String       @db.VarChar(200)
  answer     String       @db.VarChar(2000)
  created_at DateTime     @default(now())
  company_id Int?
  company    jmkcompany?  @relation(fields: [company_id], references: [serial])
  type       jmk_faq_type
}

model jmk_testimonial {
  serial               Int      @id @default(autoincrement())
  usr_name             String   @db.VarChar(200)
  usr_label            String   @db.VarChar(200)
  usr_company          String?  @db.VarChar(200)
  type                 String   @default("celsius") @db.VarChar(200)
  usr_star             Int?
  usr_img              String   @db.VarChar(500)
  usr_img_key          String   @db.VarChar(500)
  usr_company_logo     String?  @db.VarChar(500)
  usr_company_logo_key String?  @db.VarChar(500)
  created_at           DateTime @default(now())
  testimonial          String   @db.LongText
}

model jmktstdpayinfo {
  pay_id         Int       @id @default(autoincrement())
  payment_date   DateTime? @default(dbgenerated("(curdate())")) @db.Date
  pay_amount     Int?
  std_id         Int?
  transaction_id String?   @db.VarChar(30)
  pay_verified   Boolean?  @default(false)
  crs_id         Int?
}

model jmkstdfeediscount {
  serial           Int  @id @default(autoincrement())
  fee_id           Int?
  fee_discount_per Int?
  std_id           Int?
}

model jmkstdproj {
  serial        Int       @id @default(autoincrement())
  proj_id       Int?
  std_id        Int?
  proj_git_link String?   @db.VarChar(200)
  proj_sub_date DateTime? @db.Date
}

model contactinfo {
  serial         Int    @id @default(autoincrement())
  email_address  String
  contact_number String
}

model jmkblog {
  blog_id                Int      @id @default(autoincrement())
  blog_slug              String
  blog_type              String
  blog_heading           String
  blog_short_description String   @db.LongText
  blog_description       String   @db.LongText
  blog_image             String?  @db.VarChar(1000)
  blog_image_key         String?  @db.VarChar(1000)
  blog_logo              String?  @db.VarChar(1000)
  blog_logo_key          String?  @db.VarChar(1000)
  blog_meta_title        String
  blog_meta_description  String
  blog_meta_keyword      String
  created_at             DateTime @default(now())
  updated_at             DateTime @db.Date
  author                 String
  created_by             Int
  status                 Boolean  @default(false)
}

model jmkstdreceipt {
  receipt_no     Int       @id @default(autoincrement())
  receipt_date   DateTime? @db.Date
  std_id         Int?
  receipt_amount Int?
  receipt_desc   String?   @db.VarChar(100)
}

model jmk_std_ques {
  ques_id          Int                              @id @default(autoincrement())
  instance_id      Int
  ques_description String                           @db.LongText
  student_id       Int
  severity_level   jmk_std_ques_severity_level_enum @default(Green)
  status           Boolean                          @default(false)
  created_at       DateTime?                        @default(now())
  updated_at       DateTime?                        @default(now())
  ques_title       String                           @db.VarChar(500)
  ques_image       String?
  ques_image_key   String?
}

model jmk_ques_ans {
  ans_id      Int                         @id @default(autoincrement())
  user_type   jmk_ques_ans_user_type_enum @default(Student)
  question_id Int
  student_id  Int?
  teacher_id  Int?
  answer      String                      @db.LongText
  created_at  DateTime?                   @default(now())
  updated_at  DateTime?                   @default(now())
}

model jmk_ques_ans_imp {
  imp_id      Int                         @id @default(autoincrement())
  user_type   jmk_ques_ans_user_type_enum @default(Student)
  imp_type    jmk_ques_ans_imp_type_enum  @default(Question)
  question_id Int?
  ans_id      Int?
  student_id  Int?
  teacher_id  Int?
  upvote      Int                         @default(0)
  downvote    Int                         @default(0)
  created_at  DateTime                    @default(now())
  updated_at  DateTime                    @default(now())
}

model jmk_ques_sub {
  sub_id      Int      @id @default(autoincrement())
  question_id Int
  student_id  Int
  created_at  DateTime @default(now())
}

model jmk_chats {
  chat_id     Int                         @id @default(autoincrement())
  receiver_id Int
  sender_id   Int
  user_type   jmk_ques_ans_user_type_enum
  created_at  DateTime                    @default(now())
  message     String                      @db.VarChar(1000)
  isSeen      Boolean                     @default(false)
  chat_type   jmk_chat_type_enum          @default(Text)
}

model jmk_group_chats {
  chat_id     Int                         @id @default(autoincrement())
  sender_id   Int
  user_type   jmk_ques_ans_user_type_enum
  created_at  DateTime                    @default(now())
  message     String                      @db.VarChar(1000)
  isSeen      Boolean                     @default(false)
  chat_type   jmk_chat_type_enum          @default(Text)
  receiver_id Int
}

model jmk_chat_group {
  group_id   Int      @id @default(autoincrement())
  teacher_id Int
  created_at DateTime @default(now())
  group_name String
  crs_id     Int
  lastSeen   DateTime @default(now())
}

model jmk_chat_group_student {
  group_id   Int
  std_id     Int
  created_at DateTime @default(now())
  serial     Int      @id @default(autoincrement())
}

model jmk_web_details {
  serial          Int                       @id @default(autoincrement())
  phone           String
  phone1          String
  email           String
  logo            String?
  logo_key        String?
  tertiary_color  String?
  primary_color   String?
  secondary_color String?
  description     String?                   @db.LongText
  location        String?
  type            jmk_web_details_type_enum
  qr              String?
  qr_key          String?
  bank_name       String?
  company_name    String?
  company_account String?
  company_phone   String?
  company_id      Int?
}

model jmk_web_modal {
  serial  Int     @id @default(autoincrement())
  status  Boolean
  img     String
  img_key String
}

model jmk_web_career {
  serial               Int         @id @default(autoincrement())
  title                String
  description          String      @db.LongText
  department           String
  employment_type      String
  employment_structure String
  location             String
  created_at           DateTime    @default(now())
  status               Boolean
  seo_description      String?
  seo_title            String?
  jmkjobReq            jmkjobReq[]
}

model jmk_crs_categories {
  serial      Int          @id @default(autoincrement())
  title       String
  description String       @db.LongText
  icon        String
  icon_key    String
  company_id  Int
  company     jmkcompany   @relation(fields: [company_id], references: [serial])
  created_at  DateTime     @default(now())
  courses     jmkcrsinfo[]
}

model jmk_services {
  serial            Int      @id @default(autoincrement())
  title             String
  description       String   @db.LongText
  long_description  String   @db.LongText
  short_description String   @db.LongText
  icon              String
  icon_key          String
  created_at        DateTime @default(now())
  seo_description   String?
  seo_title         String?
}

model jmk_policy {
  serial           Int      @id @default(autoincrement())
  shot_description String   @db.VarChar(1000)
  description      String   @db.LongText
  created_at       DateTime @default(now())
}

model jmk_partner_ui {
  serial     Int      @id @default(autoincrement())
  title      String   @db.VarChar(1000)
  icon       String
  icon_key   String
  created_at DateTime @default(now())
}

model jmk_notifications {
  serial     Int                   @id @default(autoincrement())
  user_type  jmk_notification_type
  user_id    Int
  category   String
  link       String?
  message    String
  is_read    Boolean
  created_at DateTime              @default(now())
  label1     String?
  label2     String?
}

model jmk_promo_code {
  serial        Int             @id @default(autoincrement())
  name          String
  code          String          @unique
  discount      Int
  upto          Int
  created_at    DateTime        @default(now())
  expiry_date   DateTime        @default(now())
  crs_id        Int
  jmkstdcrsinfo jmkstdcrsinfo[]
}

model jmk_crs_blog {
  serial            Int                     @id @default(autoincrement())
  title             String                  @unique
  short_description String
  long_description  String                  @db.LongText
  img               String
  img_key           String
  crs_id            Int
  tr_id             Int
  created_at        DateTime                @default(now())
  trainer           jmktrinfo               @relation(fields: [tr_id], references: [tr_id], onDelete: Cascade, onUpdate: NoAction)
  comments          jmk_crs_blog_comments[]

  @@index([tr_id], map: "jmk_crs_blog_tr_id_fkey")
}

model jmk_crs_blog_comments {
  serial     Int          @id @default(autoincrement())
  comment    String
  std_id     Int
  blog_id    Int
  created_at DateTime     @default(now())
  blog       jmk_crs_blog @relation(fields: [blog_id], references: [serial], onDelete: Cascade, onUpdate: NoAction)
  student    jmkstdinfo   @relation(fields: [std_id], references: [std_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([blog_id], map: "jmk_crs_blog_comments_blog_id_fkey")
  @@index([std_id], map: "jmk_crs_blog_comments_std_id_fkey")
}

model jmk_std_attendance {
  serial     Int        @id @default(autoincrement())
  attendance Boolean    @default(false)
  std_id     Int
  crs_id     Int
  created_at DateTime   @default(now())
  course     jmkcrsinfo @relation(fields: [crs_id], references: [crs_id], onDelete: Cascade, onUpdate: NoAction)
  student    jmkstdinfo @relation(fields: [std_id], references: [std_id], onDelete: Cascade, onUpdate: NoAction)

