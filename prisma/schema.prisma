  title             String          @db.VarChar(100)
  isDeleted         Boolean         @default(false)
  requirements      String          @db.LongText
  jmkcrsLearing     jmkcrsLearing[]
  jmkcrsTiming      jmkcrsTiming[]
  jmkcrsdet         jmkcrsdet[]
  jmkstdinfo        jmkstdinfo[]
}

