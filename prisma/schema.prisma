  @@index([crs_id], map: "crs_id_vid_fk")
}

model jmkgrvinfo {
  grv_id     Int        @id @default(autoincrement())
  std_id     Int
  grv_date   DateTime   @db.Date
  grv_type   String     @db.VarChar(30)
  grv_desc   String     @db.VarChar(200)
  grv_rate   String     @db.VarChar(30)
  jmkstdinfo jmkstdinfo @relation(fields: [std_id], references: [std_id], onDelete: NoAction, onUpdate: NoAction, map: "grv_std_fk")

  @@index([std_id], map: "grv_std_fk")
}

model jmkcontact {
  serial   Int       @id @default(autoincrement())
  cmobile  String?   @db.VarChar(15)
  cemail   String?   @db.VarChar(30)
