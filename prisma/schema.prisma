generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model jmkcrsinfo {
  crs_id          Int          @id @default(autoincrement())
  crs_name        String       @db.VarChar(200)
  crs_desc        String       @db.VarChar(1000)
  crs_duration    Int?
  crs_rate        Int?
  crs_cat         String?      @db.VarChar(1000)
  crs_cat_id      String?      @db.VarChar(1000)
  crs_con         String?      @db.VarChar(1000)
  crs_con_id      String?      @db.VarChar(1000)
  crs_ins         String?      @db.VarChar(200)
  crs_type        String       @db.VarChar(200)
  crs_nxt_st_date DateTime?    @db.Date
  crs_image       String?      @db.VarChar(1000)
  crs_image_key   String?      @db.VarChar(1000)
  cid             Int?
  crs_code        String?      @db.VarChar(40)
  tr_id           Int?
  jmkcrstest      jmkcrstest[]
  jmkstdinfo      jmkstdinfo[]
  jmkvidinfo      jmkvidinfo[]
}

model jmkstdinfo {
  std_id            Int            @id @default(autoincrement())
  std_fname         String         @db.VarChar(20)
  std_mname         String?        @db.VarChar(20)
  std_lname         String         @db.VarChar(20)
  std_email         String         @db.VarChar(30)
  std_mobile        String         @db.VarChar(15)
  std_join_dt       DateTime?      @default(dbgenerated("(curdate())")) @db.Date
  std_birth_dt      DateTime?      @db.Date
  std_high_ql       String?        @db.VarChar(40)
  crs_id            Int?           @default(28)
  std_status        Int?
  std_paidup        Int?
  std_due           Int?
  std_password      String         @db.VarChar(16)
  crs_complete      Boolean?       @default(false)
  crs_complete_date DateTime?      @db.Date
  std_remark        String?        @db.VarChar(1000)
  crs_ecp_st_d      DateTime?      @db.Date
  std_pic           String?        @db.VarChar(200)
  std_pic_key       String?        @db.VarChar(100)
  std_verifyed      Boolean        @default(false)
  cid               Int?
  crsmain_id        Int?
  std_add_house_no  String?        @db.VarChar(20)
  std_add_street    String?        @db.VarChar(50)
  std_add_city      String?        @db.VarChar(50)
  std_add_ward_no   Int?
  std_add_distrcit  String?        @db.VarChar(50)
  std_add_province  String?        @db.VarChar(100)
  std_add_zone      String?        @db.VarChar(100)
  jmkgrvinfo        jmkgrvinfo[]
  jmkcrsinfo        jmkcrsinfo?    @relation(fields: [crs_id], references: [crs_id], onDelete: NoAction, onUpdate: NoAction, map: "jmkcrsinfo_crs_id_fk")
  jmkcrsmain        jmkcrsmain?    @relation(fields: [crsmain_id], references: [crsmain_id], onDelete: NoAction, onUpdate: NoAction, map: "jmkcrsmain_crsmain_id_fk")
  jmkstdreview      jmkstdreview[]

  @@index([crs_id], map: "jmkcrsinfo_crs_id_fk")
  @@index([crsmain_id], map: "jmkcrsmain_crsmain_id_fk")
}

model jmkstdreview {
  std_id        Int
  std_rate      String     @db.VarChar(200)
  std_rate_date DateTime   @db.Date
  serial        Int        @id @default(autoincrement())
  jmkstdinfo    jmkstdinfo @relation(fields: [std_id], references: [std_id], onDelete: NoAction, onUpdate: NoAction, map: "jmkstdinfo_std_id_fk")

  @@index([std_id], map: "jmkstdinfo_std_id_fk")
}

model sp_cl_info {
