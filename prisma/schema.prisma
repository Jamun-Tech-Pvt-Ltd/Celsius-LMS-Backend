generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model jmkcrsinfo {
  crs_id          Int            @id @default(autoincrement())
  crs_name        String         @db.VarChar(200)
  crs_desc        String         @db.VarChar(1000)
  crs_duration    Float?
  crs_rate        Int?
  crs_ins         String?        @db.VarChar(200)
  crs_type        String         @db.VarChar(200)
  crs_nxt_st_date DateTime?      @db.Date
  crs_image       String?        @db.VarChar(1000)
  crs_image_key   String?        @db.VarChar(1000)
  cid             Int?
  crs_code        String?        @db.VarChar(40)
  lavel           String?        @db.VarChar(200)
  time            String?        @db.VarChar(200)
  meetLink        String?        @db.VarChar(1000)
  isDeleted       Boolean        @default(false)
  jmkcrstest      jmkcrstest[]
  jmkstdinfo      jmkstdinfo[]
  jmktrcrsinfo    jmktrcrsinfo[]
  jmkvidinfo      jmkvidinfo[]
}

model jmk_tr_week {
  week_id          Int                @id @default(autoincrement())
  crs_id           Int
  title            String             @db.VarChar(100)
  description      String             @db.VarChar(1000)
  created_at       DateTime           @default(now())
  jmk_week_content jmk_week_content[]
}

model jmk_week_content {
  content_id    Int              @id @default(autoincrement())
  title         String           @db.VarChar(100)
  description   String           @db.VarChar(1000)
  type          jmk_content_type
  week_id       Int
  video_url     String?          @db.VarChar(1000)
  project_url   String?          @db.VarChar(1000)
  duration      String?          @db.VarChar(100)
  level         String?          @db.VarChar(100)
  share_date    String?          @db.VarChar(100)
  date          DateTime         @default(now())
  video_url_key String?          @db.VarChar(1000)
  jmk_tr_week   jmk_tr_week      @relation(fields: [week_id], references: [week_id])

  @@index([week_id], map: "jmk_week_content_week_id_fkey")
}

model jmk_test_set {
  test_set_id Int     @id @default(autoincrement())
  content_id  Int
  question    String? @db.VarChar(100)
  ans1        String? @db.VarChar(100)
  ans2        String? @db.VarChar(100)
  ans3        String? @db.VarChar(100)
  ans4        String? @db.VarChar(100)
  hint        String? @db.VarChar(100)
  rtans       String? @db.VarChar(100)
}

model jmk_std_test_result {
  serial             Int      @id @default(autoincrement())
  content_id         Int
  std_id             Int
  test_complete      Boolean  @default(false)
  score              String   @default("0")
  question_attempted Int      @default(0)
  time_taken         String   @default("")
  created_at         DateTime @default(now())
}

model jmk_std_test_ans {
  serial      Int    @id @default(autoincrement())
  content_id  Int
  std_id      Int
  std_ans     String
  test_set_id Int
}

model jmk_std_week_note {
  serial     Int      @id @default(autoincrement())
  week_id    Int
  std_id     Int
  std_note   String   @db.MediumText
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model jmkstdinfo {
  std_id           Int            @id @default(autoincrement())
  std_fname        String         @db.VarChar(20)
  std_mname        String?        @db.VarChar(20)
  std_lname        String         @db.VarChar(20)
  std_email        String         @db.VarChar(30)
  std_mobile       String         @db.VarChar(15)
  std_join_dt      DateTime?      @default(dbgenerated("(curdate())")) @db.Date
  std_birth_dt     DateTime?      @db.Date
  std_high_ql      String?        @db.VarChar(40)
  crs_id           Int?           @default(28)
  std_password     String         @db.VarChar(16)
  std_remark       String?        @db.VarChar(1000)
  crs_ecp_st_d     DateTime?      @db.Date
  std_pic          String?        @db.VarChar(200)
  std_pic_key      String?        @db.VarChar(100)
  std_verifyed     Boolean        @default(false)
  cid              Int?
  crsmain_id       Int?
  std_add_house_no String?        @db.VarChar(20)
  std_add_street   String?        @db.VarChar(50)
  std_add_city     String?        @db.VarChar(50)
  std_add_ward_no  Int?
  std_add_province String?        @db.VarChar(100)
  std_add_zone     String?        @db.VarChar(100)
  lastSeen         DateTime       @default(now())
  std_add_district String?        @db.VarChar(50)
  std_country      String?        @db.VarChar(100)
  std_company      String?        @db.VarChar(200)
  std_institute    String?        @db.VarChar(200)
  jmkgrvinfo       jmkgrvinfo[]
  jmkcrsinfo       jmkcrsinfo?    @relation(fields: [crs_id], references: [crs_id], onDelete: Cascade, onUpdate: NoAction, map: "jmkcrsinfo_crs_id_fk")
  jmkcrsmain       jmkcrsmain?    @relation(fields: [crsmain_id], references: [crsmain_id], onDelete: Cascade, onUpdate: NoAction, map: "jmkcrsmain_crsmain_id_fk")
  jmkstdreview     jmkstdreview[]

  @@index([crs_id], map: "jmkcrsinfo_crs_id_fk")
  @@index([crsmain_id], map: "jmkcrsmain_crsmain_id_fk")
}

model jmkstdreview {
  std_id        Int
  std_rate      String     @db.VarChar(200)
  std_rate_date DateTime   @db.Date
  serial        Int        @id @default(autoincrement())
  jmkstdinfo    jmkstdinfo @relation(fields: [std_id], references: [std_id], onDelete: NoAction, onUpdate: NoAction, map: "jmkstdinfo_std_id_fk")

  @@index([std_id], map: "jmkstdinfo_std_id_fk")
}

model sp_cl_info {
  client_id      Int       @id @default(autoincrement())
  client_fname   String?   @db.VarChar(20)
  client_mname   String?   @db.VarChar(20)
  client_lname   String?   @db.VarChar(20)
  client_tech1   String?   @db.VarChar(20)
  client_tech2   String?   @db.VarChar(20)
  client_tech3   String?   @db.VarChar(20)
  client_otechs  String?   @db.VarChar(100)
  dt_start       DateTime? @db.Date
  client_email   String?   @db.VarChar(30)
  client_contact String?   @db.VarChar(20)
}

model sp_dev_connect {
  connect_id   Int       @id @default(autoincrement())
  developer_id Int?
